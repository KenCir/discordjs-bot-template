{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "discordjs-bot-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"lint": "prettier --check . && eslint --ext .ts --format=pretty src",
		"deploy": "node --env-file=.env dist/util/deploy.js",
		"deploy:guild": "node --env-file=.env dist/util/deployGuild.js",
		"format": "prettier --write . && eslint --ext .ts --fix --format=pretty src",
		"start": "node --env-file=.env dist/index.js",
		"dev": "NODE_ENV=development node --env-file=.env --enable-source-maps dist/index.js"
	},
	"dependencies": {
		"@discordjs/core": "^2.6.0",
		"bufferutil": "^4.1.0",
		"discord.js": "^14.27.0",
		"pino": "^10.4.0",
		"zlib-sync": "^0.1.10",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-config-neon": "^0.5.4",
		"eslint-formatter-compact": "^9.0.1",
		"eslint-formatter-pretty": "^7.1.0",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
